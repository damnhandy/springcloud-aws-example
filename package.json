{
  "name": "springboot-app",
  "version": "0.1.0",
  "bin": {
    "infrastructure": "bin/springboot-app.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "deploy": "npx cdk deploy --all --require-approval never",
    "lint": "eslint . --ext .ts",
    "lint-and-fix": "eslint . --ext .ts --fix",
    "prepare": "husky install",
    "prettier-format": "prettier --write .",
    "prettier-watch": "onchange '**/*.*' -- prettier --write {{changed}}",
    "test": "jest",
    "type-check": "tsc --project tsconfig.json --pretty --noEmit",
    "verify": "cinc-auditor exec verification -t aws://",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@aws-cdk/app-staging-synthesizer-alpha": "2.200.2-alpha.0",
    "@aws-sdk/client-codebuild": "^3.828.0",
    "aws-cdk-lib": "2.200.2",
    "aws-lambda": "^1.0.7",
    "constructs": "^10",
    "source-map-support": "^0.5.16"
  },
  "prettier": "@polysync/prettier-config",
  "devDependencies": {
    "@eslint/js": "^9",
    "@polysync/eslint-config": "file:../polysync/polysync-eslint-config-1.0.0.tgz",
    "@polysync/prettier-config": "file:../polysync/polysync-prettier-config-1.0.0.tgz",
    "@polysync/ts-config": "file:../polysync/polysync-ts-config-1.0.0.tgz",
    "@prettier/plugin-ruby": "^1.6.0",
    "@types/aws-lambda": "ts5.5",
    "@types/jest": "ts5.5",
    "@types/node": "ts5.5",
    "@typescript-eslint/parser": "^8.34.0",
    "aws-cdk": "^2",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jest": "^28",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-unicorn": "^59",
    "husky": "^9",
    "jest": "^29",
    "jiti": "^2.4.2",
    "lint-staged": "^16",
    "prettier": "^3.5.3",
    "syncpack": "^14.0.0-alpha.13",
    "ts-jest": "^29",
    "ts-node": "^10",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.34.0"
  },
  "lint-staged": {
    "*.{js,css,md,java,sh}": "prettier --write"
  }
}
